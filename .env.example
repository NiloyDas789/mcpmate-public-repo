# Copy to .env for local development. Keys are auto-prefixed with
# Config::VAR_PREFIX when loaded (see backend/app/Dotenv.php).

# Load the Vite dev server (pnpm dev) instead of the built bundle
DEV = true
DEV_URL = http://localhost:3000

# Optional HTTPS for the Vite dev server
DEV_SSL = false
DEV_SSL_CERT_PATH =
DEV_SSL_KEY_PATH =

# MCPMate Pro: the license server (https; http only on a local site) and
# where "Upgrade to Pro" links to (empty hides the link)
LICENSE_API_URL =
UPGRADE_URL =

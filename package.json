{
  "name": "mcpmate",
  "version": "1.0.0",
  "license": "GPL-2.0-or-later",
  "author": "Niloy Das",
  "type": "module",
  "scripts": {
    "build": "tsc && vite build",
    "check": "pnpm ts-check && pnpm lint:check && pnpm lint:css:check && pnpm format:check && pnpm test",
    "dev": "vite",
    "format:check": "prettier ./frontend/src --check",
    "i18n": "pnpm i18n:pot && pnpm i18n:remap && pnpm i18n:build && pnpm i18n:mo",
    "i18n:build": "node tools/i18n-po.mjs build",
    "i18n:mo": "for f in languages/*.po; do [ -e \"$f\" ] || continue; msgfmt --check -o \"${f%.po}.mo\" \"$f\"; done",
    "i18n:msgids": "node tools/i18n-po.mjs msgids",
    "i18n:pot": "wp i18n make-pot . languages/mcpmate.pot --domain=mcpmate --exclude=node_modules,vendor,build,assets,frontend,tools,.claude,.codex,.cursor --package-name='McpMate' && node tools/i18n-extract-js.mjs frontend/src languages/mcpmate.pot && msguniq --no-wrap languages/mcpmate.pot -o languages/mcpmate.pot",
    "i18n:remap": "node tools/i18n-po.mjs remap",
    "lint": "eslint frontend/src --fix",
    "lint:check": "eslint frontend/src",
    "lint:css": "stylelint 'frontend/**/*.{css,scss}' --fix",
    "lint:css:check": "stylelint 'frontend/**/*.{css,scss}'",
    "lint:php": "composer phpcs",
    "pretty": "prettier ./frontend/src --check --write",
    "preview": "vite preview",
    "test": "vitest --watch=false",
    "test:a11y": "node tools/a11y-ui-kit.mjs",
    "test:cover": "vitest --coverage",
    "test:e2e": "playwright test",
    "test:watch": "vitest --watch=true",
    "ts-check": "tsc --noEmit"
  },
  "dependencies": {
    "@ant-design/cssinjs": "^1.23.0",
    "@ant-design/icons": "^5.6.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@tanstack/react-query": "^5.67.2",
    "@tanstack/react-query-devtools": "^5.67.2",
    "@wordpress/i18n": "^6.26.0",
    "antd": "^5.23.1",
    "jotai": "^2.12.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.55.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.13.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.0.8",
    "autoprefixer": "^10.4.21",
    "axe-core": "4.10.3",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.5.0",
    "happy-dom": "^16.8.1",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "stylelint": "^16.15.0",
    "stylelint-config-standard": "^37.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vite": "^6.2.1",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.0.8"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  }
}
